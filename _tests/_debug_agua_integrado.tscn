[sub_resource type="GDScript" id="GDScript_7fnfn"]
script/source = "extends Node3D

const DUMMY_SCENE: PackedScene = preload(\"res://personaje/transformaciones/acuatica/scenes/training_dummy.tscn\")

@export var qa_menu_only: bool = false

var mundo: Node3D
var jugador: ControladorLeo
var camara: Camera3D
var dummy: TrainingDummy
var _tiempo: float = 0.0
var _salud_previa: float = -1.0
var _turbo_previo: float = 0.0
var _cooldown_previo: float = 0.0
var _nadando_previo: bool = false
var _combo_previo: bool = false
var _clip_previo: StringName = &\"\"
var _emite_burbujas_previo: bool = false
var _emite_estela_previo: bool = false
var _posicion_previa: Vector3 = Vector3.ZERO
var _distancia_con_w: float = 0.0
var _midiendo_w: bool = false
var _contador_reportes: int = 0
var _dummy_colocado: bool = false

func _ready() -> void:
	if qa_menu_only:
		call_deferred(\"_preparar_menu\")
	else:
		call_deferred(\"_preparar_escenario\")

func _preparar_menu() -> void:
	mundo = get_node(\"ZibaPrototipo\") as Node3D
	await get_tree().process_frame
	jugador = mundo.get_node(\"Jugador\") as ControladorLeo
	camara = jugador.get_node(\"PivoteCamara/Brazo/Camara\") as Camera3D
	camara.make_current()
	await get_tree().create_timer(0.65).timeout
	jugador.menu_transf.transformacion_elegida.connect(_on_menu_forma_elegida)
	jugador.menu_transf.abrir()
	await get_tree().process_frame
	var pes: Control = jugador.menu_transf.get_node(\"Centro/Iconos/pes\") as Control
	print(\"[QA_MENU] OPEN visible=%s open=%s icons=%d pes_rect=%s viewport=%s input_mouse=%d\" % [str(jugador.menu_transf.visible), str(jugador.menu_transf.esta_abierto()), jugador.menu_transf.get_node(\"Centro/Iconos\").get_child_count(), str(pes.get_global_rect()), str(get_viewport().get_visible_rect()), Input.mouse_mode])

func _on_menu_forma_elegida(id: StringName) -> void:
	print(\"[QA_MENU] SIGNAL id=%s current_form=%s\" % [String(id), String(jugador.id_forma())])

func _preparar_escenario() -> void:
	mundo = get_node(\"ZibaPrototipo\") as Node3D
	await get_tree().process_frame
	jugador = mundo.get_node(\"Jugador\") as ControladorLeo
	camara = jugador.get_node(\"PivoteCamara/Brazo/Camara\") as Camera3D
	camara.make_current()
	# El encuadre usa el mundo integrado; sólo se coloca al jugador en mar abierto
	# para que la prueba empiece sin recorrer los 200 m que separan el spawn del mar.
	await get_tree().create_timer(0.65).timeout
	jugador.global_position = Vector3(0.0, -3.0, 240.0)
	jugador.velocity = Vector3.ZERO
	jugador.acuatico.rotation.y = 0.0
	jugador._entrar_acuatico()
	dummy = DUMMY_SCENE.instantiate() as TrainingDummy
	mundo.add_child(dummy)
	await get_tree().process_frame
	dummy.collision_layer = 0
	dummy.collision_mask = 0
	dummy.global_position = Vector3(700.0, -3.0, 700.0)
	dummy.max_health = 1000.0
	dummy.health = dummy.max_health
	_salud_previa = dummy.health
	_posicion_previa = jugador.global_position
	print(\"[QA_AGUA] READY form=%s pos=%s depth=%.2f camera_current=%s anim_has_jab=%s anim_has_swim=%s\" % [str(jugador.id_forma()), str(jugador.global_position), jugador.profundidad_agua(jugador.global_position.x, jugador.global_position.z), str(camara.current), str(jugador.anim_acuatico.has_animation(\"combo_agua/jab\")), str(jugador.anim_acuatico.has_animation(\"swim_forward\"))])

func _physics_process(delta: float) -> void:
	if jugador == null or not is_instance_valid(jugador):
		return
	_tiempo += delta
	var movimiento_w: bool = Input.is_action_pressed(\"mover_adelante\")
	if movimiento_w:
		_acumular_distancia(delta)
	if jugador.a_nadando and not _dummy_colocado and Input.is_action_just_pressed(\"atacar\"):
		_colocar_dummy_delante()
	if Input.is_action_just_pressed(\"atacar\") and dummy != null and _dummy_colocado:
		print(\"[QA_AGUA] ATTACK_INPUT t=%.2f swimming=%s combo_active=%s attack_clip=%s\" % [_tiempo, str(jugador.a_nadando), str(jugador.a_combo_activo), String(jugador.anim_acuatico.current_animation)])
		if not jugador.a_nadando:
			print(\"[QA_AGUA] ATTACK_REJECTED_NOT_SWIMMING\")
	var efecto: BurbujasAcuaticas = jugador.get_node(\"BurbujasAcuaticas\") as BurbujasAcuaticas
	var burbuja: GPUParticles3D = efecto.get_node_or_null(\"BurbujasCabeza\") as GPUParticles3D
	var estela: GPUParticles3D = efecto.get_node_or_null(\"EstelaTurbo\") as GPUParticles3D
	var burbujas_emiten: bool = burbuja != null and burbuja.emitting
	var estela_emite: bool = estela != null and estela.emitting
	if jugador.a_nadando != _nadando_previo:
		_nadando_previo = jugador.a_nadando
		print(\"[QA_AGUA] SWIM_STATE t=%.2f swimming=%s clip=%s pos=%s\" % [_tiempo, str(jugador.a_nadando), String(jugador.anim_acuatico.current_animation), str(jugador.global_position)])
	if burbujas_emiten != _emite_burbujas_previo:
		_emite_burbujas_previo = burbujas_emiten
		print(\"[QA_AGUA] HEAD_BUBBLES t=%.2f exists=%s emitting=%s\" % [_tiempo, str(burbuja != null), str(burbujas_emiten)])
	if jugador.a_turbo_t > 0.0 and _turbo_previo <= 0.0:
		print(\"[QA_AGUA] TURBO_START t=%.2f remaining=%.2f cooldown=%.2f dir=%s velocity=%s\" % [_tiempo, jugador.a_turbo_t, jugador.a_turbo_cooldown, str(jugador.a_turbo_dir), str(jugador.velocity)])
		if _midiendo_w:
			_distancia_con_w = 0.0
			_midiendo_w = false
	if jugador.a_turbo_t <= 0.0 and _turbo_previo > 0.0:
		print(\"[QA_AGUA] TURBO_END t=%.2f cooldown=%.2f wake_emitting=%s\" % [_tiempo, jugador.a_turbo_cooldown, str(estela_emite)])
	if estela_emite != _emite_estela_previo:
		_emite_estela_previo = estela_emite
		print(\"[QA_AGUA] TURBO_WAKE t=%.2f exists=%s emitting=%s\" % [_tiempo, str(estela != null), str(estela_emite)])
	if Input.is_action_just_pressed(\"agua_turbo\"):
		var turbo_listo: bool = jugador.a_nadando and jugador.a_turbo_t <= 0.0 and jugador.a_turbo_cooldown <= 0.0 and not jugador.a_en_habilidad and not jugador.a_ataque_activo and not jugador.a_subiendo_escalera
		print(\"[QA_AGUA] TURBO_INPUT t=%.2f ready=%s active=%.2f cooldown=%.2f swimming=%s\" % [_tiempo, str(turbo_listo), jugador.a_turbo_t, jugador.a_turbo_cooldown, str(jugador.a_nadando)])
		if not turbo_listo and jugador.a_nadando:
			print(\"[QA_AGUA] TURBO_REJECTED t=%.2f active=%.2f cooldown=%.2f\" % [_tiempo, jugador.a_turbo_t, jugador.a_turbo_cooldown])
	if _cooldown_previo > 0.0 and jugador.a_turbo_cooldown <= 0.0:
		print(\"[QA_AGUA] TURBO_COOLDOWN_READY t=%.2f active=%.2f swimming=%s\" % [_tiempo, jugador.a_turbo_t, str(jugador.a_nadando)])
	if jugador.a_combo_activo != _combo_previo:
		_combo_previo = jugador.a_combo_activo
		var clip_inactivo: String = String(jugador.a_combo_golpe.animation) if jugador.a_combo_golpe != null else \"\"
		print(\"[QA_AGUA] COMBO_STATE t=%.2f active=%s chain=%d clip=%s phase=%.3f hit_done=%s health=%.1f\" % [_tiempo, str(jugador.a_combo_activo), jugador.a_combo_cadena, clip_inactivo, jugador.a_combo_fase, str(jugador.a_combo_hecho), dummy.health if dummy != null else -1.0])
	if jugador.anim_acuatico.current_animation != _clip_previo:
		_clip_previo = jugador.anim_acuatico.current_animation
		if String(_clip_previo).begins_with(\"combo_agua/\") or String(_clip_previo).begins_with(\"swim\"): 
			print(\"[QA_AGUA] ANIMATION t=%.2f clip=%s chain=%d attack=%s\" % [_tiempo, String(_clip_previo), jugador.a_combo_cadena, String(jugador.a_combo_golpe.animation) if jugador.a_combo_golpe != null else \"none\"])
	if dummy != null and dummy.health < _salud_previa:
		print(\"[QA_AGUA] DAMAGE t=%.2f before=%.1f after=%.1f dealt=%.1f combo_chain=%d combo_clip=%s\" % [_tiempo, _salud_previa, dummy.health, _salud_previa - dummy.health, jugador.a_combo_cadena, String(jugador.a_combo_golpe.animation) if jugador.a_combo_golpe != null else \"none\"])
		_salud_previa = dummy.health
	_turbo_previo = jugador.a_turbo_t
	_cooldown_previo = jugador.a_turbo_cooldown
	_posicion_previa = jugador.global_position
	_contador_reportes += 1
	if _contador_reportes >= 60:
		_contador_reportes = 0
		print(\"[QA_AGUA] SAMPLE t=%.2f form=%s swim=%s pos=%s velocity=%s speed=%.2f anim=%s turbo=%.2f cooldown=%.2f head=%s wake=%s W_distance=%.2f combo_active=%s\" % [_tiempo, str(jugador.id_forma()), str(jugador.a_nadando), str(jugador.global_position), str(jugador.velocity), Vector2(jugador.velocity.x, jugador.velocity.z).length(), String(jugador.anim_acuatico.current_animation), jugador.a_turbo_t, jugador.a_turbo_cooldown, str(burbujas_emiten), str(estela_emite), _distancia_con_w, str(jugador.a_combo_activo)])

func _acumular_distancia(_delta: float) -> void:
	if not _midiendo_w:
		_midiendo_w = true
		_posicion_previa = jugador.global_position
	else:
		_distancia_con_w += jugador.global_position.distance_to(_posicion_previa)
		_posicion_previa = jugador.global_position

func _colocar_dummy_delante() -> void:
	var delante: Vector3 = -jugador.acuatico.global_transform.basis.z
	delante.y = 0.0
	delante = delante.normalized()
	dummy.global_position = jugador.global_position + delante * 1.25
	_dummy_colocado = true
	print(\"[QA_AGUA] TARGET_READY pos=%s distance=%.2f facing=%s health=%.1f\" % [str(dummy.global_position), Vector2(dummy.global_position.x - jugador.global_position.x, dummy.global_position.z - jugador.global_position.z).length(), str(delante), dummy.health])
"

