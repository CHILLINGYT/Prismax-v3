extends Node3D
## PRUEBAS DE PASOS por el INTERIOR DE LA CASA DE LEO (Tareas 1, 1B, 2, 3 y 4).
##
## No coloca al jugador a mano: lo hace ANDAR de verdad (pulsando los mandos del
## juego, con la cámara que le puso la entrada) sobre la escena REAL, y comprueba
## con medidas donde acaba. Así se prueban de una vez la colocación, la escala, las
## colisiones del modelo, los cristales de las ventanas y el aviso de salida.
##
## Comprueba:
##   1. aparece delante del vano del dormitorio (el de la captura) y la salida está
##      a mano: el HUD recibe el aviso exacto;
##   2. el modelo se agrandó de forma UNIFORME y el techo está a ~3,0 m;
##   3. hay colisión real por malla y tres cristales en los vanos exteriores;
##   4. se PASA A PIE por el vano del dormitorio (las puertas están abiertas);
##   5. la ventana del dormitorio NO se cruza: el cristal invisible lo frena dentro
##      de la casa, sin caerse;
##   6. la salida NO se ofrece desde el dormitorio (sólo delante de la puerta), y
##      vuelve a ofrecerse al regresar al pasillo;
##   7. caminando por el pasillo llega al salón y el muro sur lo frena sin salirse;
##   8. hay ciudad de verdad fuera: edificios y miles de ventanas encendidas.

const CASA := "res://casa_leo/casa_leo.tscn"
const TEXTO_SALIDA := "Presiona E para salir a la ciudad"
## Fotogramas de física que se mantiene pulsado cada mando (60 Hz: 60 = 1 s).
const PASOS_PUERTA := 150
const PASOS_MURO := 120
const PASOS_VUELTA := 240
const PASOS_CORREDOR := 260
const PASOS_SUR := 220

var _ok := 0
var _fallos := 0
var _casa: CasaLeo
var _jug: CharacterBody3D


func _ready() -> void:
	_casa = (load(CASA) as PackedScene).instantiate() as CasaLeo
	add_child(_casa)
	await get_tree().physics_frame
	await get_tree().physics_frame
	_jug = _casa.jugador() as CharacterBody3D
	_check(_casa.listo() and _jug != null, "el interior carga con el jugador dentro")
	if _jug == null:
		_resumen()
		return
	var caja := _casa.caja_interior()
	var techo := caja.position.y + caja.size.y
	_check(is_equal_approx(_casa.escala(), 1.2), "el modelo se agrandó ×%.2f (uniforme)" % _casa.escala())
	_check(absf(techo - 3.01) < 0.06, "el techo queda a %.2f m (antes 2,51: la casa es más holgada)" % techo)
	_check(_casa.cuerpos_de_malla() == 6, "colisión REAL por malla del modelo (%d mallas)" % _casa.cuerpos_de_malla())
	_check(_casa.cristales() == 3, "cristales invisibles en los %d vanos exteriores" % _casa.cristales())
	_check(_casa.edificios() == 40 and _casa.ventanas() > 500,
			"ciudad fuera de las ventanas: %d edificios y %d ventanas" % [_casa.edificios(), _casa.ventanas()])

	# --- 1) Aparece delante del vano, con la salida a mano --------------------
	var puerta := _casa.puerta_interior()
	var d0 := Vector2(_jug.global_position.x - puerta.x, _jug.global_position.z - puerta.z).length()
	_check(d0 < 1.3, "aparece delante del vano del dormitorio (a %.2f m de la puerta)" % d0)
	_check(_jug.global_position.x > -2.15 and _jug.global_position.x < -0.70,
			"aparece DENTRO del pasillo (x %.2f, el pasillo va de -2,07 a -0,81)" % _jug.global_position.x)
	var salida := _casa.salida()
	_check(salida != null and bool(salida.call("en_rango")), "la salida está a mano al aparecer")
	var texto := String(_jug.call("texto_interaccion"))
	_check(texto == TEXTO_SALIDA, "el HUD recibe el aviso exacto ('%s')" % texto)

	# --- 2) Por el vano del dormitorio (a pie) --------------------------------
	var avance := await _andar("mover_adelante", PASOS_PUERTA)
	var p1 := _jug.global_position
	_check(p1.x > -0.2, "pasó A PIE por el vano del dormitorio (x %.2f; el vano está en -0,63)" % p1.x)
	_check(absf(avance.y) < 0.2 and p1.y > -0.3, "cruzó el vano sin caerse ni colarse por el suelo (y %.2f)" % p1.y)
	_check(not bool(salida.call("en_rango")), "desde el DORMITORIO la salida NO se ofrece (está al otro lado del muro)")
	var texto_dentro := String(_jug.call("texto_interaccion"))
	_check(texto_dentro == "", "el aviso de salida desapareció dentro del dormitorio ('%s')" % texto_dentro)

	# --- 3) La ventana del dormitorio no se cruza (cristal invisible) ---------
	await _andar("mover_adelante", PASOS_MURO)
	var p2 := _jug.global_position
	_check(p2.x > 3.0 and p2.x < 4.35,
			"la ventana este lo frena DENTRO de la casa (x %.2f; el cristal está en 4,19)" % p2.x)
	_check(p2.y > -0.4, "no se cayó a la calle por la ventana (y %.2f)" % p2.y)

	# --- 4) Vuelve al pasillo: la salida vuelve a ofrecerse -------------------
	await _andar("mover_atras", PASOS_VUELTA)
	var p3 := _jug.global_position
	_check(p3.x < -0.85, "regresó al pasillo andando (x %.2f)" % p3.x)
	_check(bool(salida.call("en_rango")), "delante de la puerta la salida se ofrece otra vez")

	# --- 5) Por el pasillo hasta el salón y freno en el muro sur --------------
	await _andar("mover_derecha", PASOS_CORREDOR)
	var p4 := _jug.global_position
	_check(p4.z > 1.4, "bajó por el pasillo hasta el salón (z %.2f; el salón empieza en 1,55)" % p4.z)
	await _andar("mover_derecha", PASOS_SUR)
	var p5 := _jug.global_position
	_check(p5.z > 4.8 and p5.z < 6.6,
			"el muro sur lo frena dentro (z %.2f; el ventanal está en 6,27)" % p5.z)
	_check(p5.y > -0.4, "sigue dentro de la casa, sin caerse a la calle (y %.2f)" % p5.y)

	# --- 6) Nada se dispara solo ---------------------------------------------
	_check(EstadoCasaLeo.hay_vuelta() == false, "no queda ninguna vuelta pendiente colgada")
	_resumen()


## Mantiene pulsado un mando del juego durante N fotogramas de física y devuelve el
## desplazamiento conseguido. Es andar DE VERDAD: el controlador mueve al jugador.
func _andar(accion: String, fotogramas: int) -> Vector3:
	var inicio := _jug.global_position
	Input.action_press(accion)
	for i in fotogramas:
		await get_tree().physics_frame
	Input.action_release(accion)
	await get_tree().physics_frame
	await get_tree().physics_frame
	return _jug.global_position - inicio


func _check(condicion: bool, texto: String) -> void:
	if condicion:
		_ok += 1
		print("[casa-pasos] OK   ", texto)
	else:
		_fallos += 1
		print("[casa-pasos] FALLO ", texto)


func _resumen() -> void:
	print("==================== CASA (pasos): %d OK / %d FALLO ====================" % [_ok, _fallos])