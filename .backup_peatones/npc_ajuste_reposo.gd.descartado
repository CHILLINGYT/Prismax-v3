class_name NPCAjusteReposo
extends SkeletonModifier3D

## Ajuste de REPOSO por modelo (hueso a hueso).
##
## La librería compartida (Citizen_Animations.res) se horneó sobre el reposo de UN modelo de
## referencia (npc_animation_baker.TARGET_RIG = Character_01.fbx): cada pista de hueso es una
## rotación local pensada para ESE reposo. Los modelos del paquete que traen una orientación de
## hueso distinta (se midió: 5 de 49, con la pelvis y los pies a ~100° del resto) aplicaban esas
## rotaciones en un marco equivocado y salían andando DE LADO y encorvados.
##
## La corrección es exacta y no retoca ningún clip:
##
##     pose_corregida = (R_modelo⁻¹ · R_referencia) · pose_animada
##
## (R = base de reposo local del hueso, normalizada). Con eso cada hueso acaba orientado igual
## que en el modelo de referencia, sin importar cómo venga su reposo. El orden de aplicación no
## importa porque la corrección es constante y se aplica hueso a hueso sobre la pose del
## fotograma: la animación sigue intacta y sólo cambia el marco en el que se expresa.
##
## Los modelos que ya coinciden con el reposo de referencia no generan ninguna corrección y este
## modificador no hace ningún trabajo por fotograma en ellos (coste cero).

const REFERENCIA := "res://NPCs/Characters/PSX/Male/Character_01.fbx"

## Reposo local de la referencia: nombre de hueso -> Basis normalizada. Se carga una sola vez.
static var _referencia: Dictionary = {}
## Modelos ya avisados por consola (para no repetir el mismo aviso 50 veces).
static var _avisados: Dictionary = {}

## Índice de hueso -> corrección (Basis). Vacío = el modelo ya coincide con la referencia.
var _correcciones: Dictionary = {}
var _huesos := 0


func _ready() -> void:
	var sk := get_parent() as Skeleton3D
	if sk == null:
		return
	_cargar_referencia()
	if _referencia.is_empty():
		return
	for i in sk.get_bone_count():
		var nombre := String(sk.get_bone_name(i))
		if not _referencia.has(nombre):
			continue
		var r_modelo := sk.get_bone_rest(i).basis.orthonormalized()
		var c: Basis = r_modelo.inverse() * (_referencia[nombre] as Basis)
		if _desvio(c) < 0.5:
			continue      # menos de medio grado: este hueso ya está en el marco de la referencia
		_correcciones[i] = c
	if not _correcciones.is_empty():
		_huesos = _correcciones.size()
		var modelo := String(sk.get_path()).split("/")[0]
		var dueño := get_parent().get_parent()
		modelo = String(dueño.get("model_scene").resource_path) if dueño != null and dueño.get("model_scene") != null else modelo
		if not _avisados.has(modelo):
			_avisados[modelo] = true
			print("[Reposo] %s: %d huesos re-expresados en el reposo de referencia" % [modelo, _huesos])


## Ángulo (grados) del giro de una corrección; sirve para descartar las despreciables.
func _desvio(c: Basis) -> float:
	return rad_to_deg(c.get_rotation_quaternion().get_angle())


func _process_modification() -> void:
	_apply()


func _process_modification_with_delta(_delta: float) -> void:
	_apply()


func _apply() -> void:
	if _correcciones.is_empty():
		return
	var sk := get_parent() as Skeleton3D
	if sk == null:
		return
	for i: int in _correcciones:
		var q := sk.get_bone_pose_rotation(i)
		var nueva: Basis = (_correcciones[i] as Basis) * Basis(q)
		sk.set_bone_pose_rotation(i, nueva.get_rotation_quaternion())


## Carga (una vez por ejecución) el reposo local del modelo de referencia. Si falta, el
## modificador se queda quieto: mejor sin corrección que con una inventada.
static func _cargar_referencia() -> void:
	if not _referencia.is_empty():
		return
	var escena: PackedScene = load(REFERENCIA)
	if escena == null:
		push_warning("NPCAjusteReposo: no está el modelo de referencia %s" % REFERENCIA)
		return
	var nodo: Node = escena.instantiate()
	var sk := nodo.find_child("Skeleton3D", true, false) as Skeleton3D
	if sk == null:
		push_warning("NPCAjusteReposo: el modelo de referencia no trae esqueleto")
		nodo.free()
		return
	for i in sk.get_bone_count():
		_referencia[String(sk.get_bone_name(i))] = sk.get_bone_rest(i).basis.orthonormalized()
	nodo.free()


## Cuántos huesos ha tenido que corregir este modelo (para las pruebas).
func huesos_corregidos() -> int:
	return _huesos