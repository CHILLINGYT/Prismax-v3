[gd_scene load_steps=9 format=3]

; Arma 3D sencilla del enemigo tirador, construida SÓLO con mallas nativas de
; Godot (caja + cilindros), sin recursos externos. Convención local:
;   · el cañón apunta hacia -Z (el "adelante" del arma),
;   · +Y es la vertical del arma, +X su derecha.
; El origen (0,0,0) está en la EMPUÑADURA, así que al anclarla a la mano basta
; con girarla y desplazarla un poco. Todos los materiales van como
; `material_override` para que el destello de daño del enemigo no les toque la
; emisión (y la boca del cañón conserve su brillo).

[sub_resource type="BoxMesh" id="BoxMesh_cuerpo"]
size = Vector3(0.07, 0.1, 0.3)

[sub_resource type="CylinderMesh" id="CylinderMesh_canon"]
top_radius = 0.018
bottom_radius = 0.018
height = 0.34
radial_segments = 10
rings = 0

[sub_resource type="CylinderMesh" id="CylinderMesh_boquilla"]
top_radius = 0.03
bottom_radius = 0.03
height = 0.04
radial_segments = 10
rings = 0

[sub_resource type="BoxMesh" id="BoxMesh_empunadura"]
size = Vector3(0.045, 0.15, 0.06)

[sub_resource type="BoxMesh" id="BoxMesh_cargador"]
size = Vector3(0.04, 0.13, 0.07)

[sub_resource type="BoxMesh" id="BoxMesh_culata"]
size = Vector3(0.05, 0.09, 0.14)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_cuerpo"]
albedo_color = Color(0.16, 0.17, 0.21, 1)
metallic = 0.7
roughness = 0.45

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_acento"]
albedo_color = Color(0.25, 0.14, 0.04, 1)
metallic = 0.3
roughness = 0.4
emission_enabled = true
emission = Color(1, 0.5, 0.12, 1)
emission_energy_multiplier = 2.2

[node name="ArmaTirador" type="Node3D"]

