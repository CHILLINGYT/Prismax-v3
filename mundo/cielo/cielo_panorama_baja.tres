[gd_resource type="Sky" load_steps=3 format=3]

; Cielo ESTÁTICO del perfil BAJA.
;
; Es un recurso PROPIO y nuevo: el cielo dinámico del juego
; (res://mundo/cielo/cielo_ciudad.tres + Cielo/shader/main.gdshader) no se toca ni se
; modifica en ningún momento. MEDIA y ALTA siguen usando el original.
;
; Coste: PanoramaSkyMaterial es una lectura de textura mapeada a la esfera
; (SkyMaterial built-in), en lugar del shader de nubes a pantalla completa.
; radiance_size = 2 (RADIANCE_SIZE_128): el cubemap de ambiente se genera una
; sola vez (el panorama es estático), así que la luz ambiental sigue viniendo
; del cielo sin el coste por fotograma del shader dinámico.

[ext_resource type="Texture2D" path="res://assets/generated/cielo_panorama_baja.png" id="1_panorama"]

[sub_resource type="PanoramaSkyMaterial" id="PanoramaSkyMaterial_baja"]
panorama = ExtResource("1_panorama")

[resource]
sky_material = SubResource("PanoramaSkyMaterial_baja")
radiance_size = 2