class_name SalidaInterior
extends Node3D
## =============================================================================
##  LA SALIDA DE LA CASA DE LEO (interior)
## =============================================================================
##  Está en la puerta interior. Cuando Leo se acerca, el HUD muestra el aviso por
##  el mismo canal que todos los demás (el controlador lo publica en
##  `texto_interaccion()`), y al pulsar E vuelve a la ciudad: la misma pantalla de
##  carga del juego, con el punto de vuelta que dejó la puerta de la calle (delante
##  de su portal, mirando a la calle).
##
##  Nunca se dispara sola: hace falta estar dentro del radio y pulsar E, y una
##  guarda impide que la misma pulsación cuente dos veces. Al salir queda un bloqueo
##  breve en la puerta de la calle para que no se entre otra vez sin querer.

const RADIO_SALIDA := 2.0
const TEXTO := "Presiona E para salir a la ciudad"

@export var radio := RADIO_SALIDA

var _usando := false


func _ready() -> void:
	add_to_group("salida_interior")
	set_process(false)


func texto_prompt() -> String:
	return TEXTO


func en_rango() -> bool:
	var jugador := get_tree().get_first_node_in_group("player") as Node3D
	if jugador == null:
		return false
	return jugador.global_position.distance_to(global_position) <= radio


func puede_usar() -> bool:
	return not _usando and en_rango()


## Vuelve a la ciudad por la puerta de la calle (punto de vuelta ya marcado).
func intentar_usar() -> bool:
	if not puede_usar():
		return false
	_usando = true
	if not EstadoCasaLeo.hay_vuelta():
		# Sin punto de vuelta (por ejemplo, si se abrió la casa por su cuenta para
		# probarla) se vuelve igual: el mundo coloca a Leo donde pueda.
		EstadoCasaLeo.marcar_vuelta(global_position + Vector3(0.0, 0.0, 1.5), Vector3.FORWARD)
	print("[casa] saliendo a la ciudad desde la puerta interior")
	EstadoCasaLeo.salir(self)
	return true