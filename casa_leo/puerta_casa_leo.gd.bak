class_name PuertaCasaLeo
extends Node3D
## =============================================================================
##  LA PUERTA DE LA CASA DE LEO, EN LA CIUDAD
## =============================================================================
##  Busca una PUERTA DE VERDAD de las que genera la ciudad (el generador deja en
##  `prueba_portales` la posición de cada portal, en `prueba_portales_dir` hacia
##  dónde da y en `prueba_portales_frente` lo que sobresale el marco) y se queda con
##  la MÁS CERCANA al punto donde aparece Leo. Esa es la puerta de su casa: la que
##  tiene más a mano al empezar.
##
##  En cuanto Leo se acerca al radio de la puerta, el HUD muestra el aviso
##  ("Presiona E para entrar a la casa de Leo") por el MISMO canal que los avisos del
##  agua y de las escaleras (el controlador los publica en `texto_interaccion()` y el
##  HUD los pinta con su fundido de siempre): no hay UI nueva ni texto duplicado.
##  Al alejarse, el aviso desaparece solo.
##
##  Al pulsar E, la puerta deja el punto de vuelta (delante de ella, mirando a la
##  calle) y arranca la carga del interior con la pantalla de carga del juego. Una
##  guarda impide que la misma pulsación la dispare dos veces, y un bloqueo breve
##  evita que al volver de la casa se entre de nuevo sin querer.

const RADIO_ENTRADA := 2.4      ## m: hasta aquí se ofrece entrar
const DELANTE := 1.2            ## m desde el portal: dónde se planta Leo al volver
## Texto EXACTO del aviso del HUD en la puerta.
const TEXTO := "Presiona E para entrar a la casa de Leo"

## Nodo del generador de ciudad (se leen sus portales reales).
@export var ciudad: Node
## Radio (m) en el que la puerta acepta la E.
@export var radio := RADIO_ENTRADA

var _portal := Vector3.ZERO      ## centro del portal elegido
var _afuera := Vector3.FORWARD   ## normal hacia la calle
var _marcada := false
var _usando := false
var _t := 0.0


func _ready() -> void:
	add_to_group("puerta_casa_leo")
	set_process(true)
	# Si venimos de la casa, Leo aparece delante de su puerta (no en el punto de
	# inicio del mundo). Se aplaza un fotograma para que el jugador ya exista.
	if EstadoCasaLeo.hay_vuelta():
		call_deferred("_colocar_jugador_al_volver")


func _process(delta: float) -> void:
	if _marcada or ciudad == null:
		_t += delta
		return
	_buscar_puerta()


## Elige la puerta real de la ciudad más cercana a donde aparece Leo.
func _buscar_puerta() -> void:
	var portales: Array = ciudad.get("prueba_portales")
	var dirs: Array = ciudad.get("prueba_portales_dir")
	var est: Dictionary = ciudad.get("_est")
	if portales == null or dirs == null or portales.is_empty():
		return
	if int(est.get("portales", 0)) <= 0:
		return
	# Punto de partida de Leo: el jugador del mundo (su punto de inicio).
	var jugador := get_tree().get_first_node_in_group("player") as Node3D
	var desde := jugador.global_position if jugador != null else Vector3.ZERO
	var mejor := -1
	var mejor_d := 1e9
	for i in portales.size():
		var p: Vector3 = portales[i]
		var d := p.distance_to(desde)
		if d < mejor_d:
			mejor_d = d
			mejor = i
	if mejor < 0:
		return
	_portal = portales[mejor]
	var n: Vector3 = dirs[mejor]
	n.y = 0.0
	_afuera = n.normalized() if n.length() > 0.001 else Vector3.FORWARD
	global_position = _portal + _afuera * 0.35
	# El marcador mira a la calle (para poder orientar avisos o iconos 3D).
	look_at(global_position + _afuera, Vector3.UP)
	_marcada = true
	set_process(false)
	print("[casa] puerta de Leo en el portal %d (%s) a %.1f m de donde aparece Leo" % [
			mejor, str(_portal), mejor_d])


## --- Contrato de interacción (lo llaman el controlador y el HUD) --------------
func texto_prompt() -> String:
	return TEXTO


## ¿Leo está dentro del radio de la puerta?
func en_rango() -> bool:
	var jugador := get_tree().get_first_node_in_group("player") as Node3D
	if jugador == null:
		return false
	return jugador.global_position.distance_to(global_position) <= radio


## ¿Se puede entrar ahora mismo? (marca puesta, Leo cerca, sin bloqueo ni doble uso)
func puede_usar() -> bool:
	return _marcada and not _usando and not EstadoCasaLeo.bloqueado() and en_rango()


## Punto del portal elegido (para pruebas y depuración).
func portal() -> Vector3:
	return _portal


## A dónde sale Leo al volver de la casa.
func punto_de_salida() -> Vector3:
	return global_position + _afuera * DELANTE


## Entra en la casa: deja el punto de vuelta y arranca la carga del interior.
func intentar_usar() -> bool:
	if not puede_usar():
		return false
	_usando = true
	punto_de_salida()
	EstadoCasaLeo.marcar_vuelta(global_position + _afuera * DELANTE, -_afuera)
	print("[casa] entrando a la casa de Leo desde %s" % str(_portal))
	EstadoCasaLeo.entrar(self)
	return true


## Al volver de la casa, Leo aparece delante de su puerta mirando a la calle.
func _colocar_jugador_al_volver() -> void:
	# La vuelta se CONSUME aquí (una sola vez): no queda nada colgando esperando.
	if not EstadoCasaLeo.tomar_vuelta():
		return
	var punto := EstadoCasaLeo.punto_de_vuelta()
	var mira := EstadoCasaLeo.mirada_de_vuelta()
	var jugador := get_tree().get_first_node_in_group("player") as Node3D
	if jugador == null:
		return
	jugador.global_position = punto + Vector3.UP * 0.2
	# Mira a la calle, a la altura del cuerpo (nunca con un objetivo encima).
	var objetivo := Vector3(punto.x + mira.x * 10.0, jugador.global_position.y, punto.z + mira.z * 10.0)
	jugador.look_at(objetivo, Vector3.UP)
	print("[casa] Leo vuelve a la calle delante de su puerta (%s)" % str(punto))