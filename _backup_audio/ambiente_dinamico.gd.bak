class_name AmbienteDinamico
extends Node
## =============================================================================
##  AUDIO AMBIENTAL DINÁMICO (CIUDAD <-> PLAYA)
## =============================================================================
##  Reproduce en bucle el ambiente de la zona del mundo donde está el jugador y
##  hace un fundido cruzado breve al cruzar la frontera. NO crea sonidos, NO toca
##  el terreno ni el generador: sólo LEE la misma matemática de `Relieve` que usa
##  el mundo para decidir dónde hay arena.
##
##  ZONAS (tres):
##    · CIUDAD: el recinto urbano (la meseta cuadrada de ±SEMI_MESETA centrada en
##      el origen). Ambiente de ciudad a su volumen normal.
##    · MONTAÑA: el interior elevado FUERA de la ciudad (bosque y macizos del
##      norte/noroeste/oeste/suroeste). Usa el MISMO WAV de ciudad pero algo más
##      fuerte. Se detecta por ser terreno elevado (`altura >= altura_montana`) o
##      pertenecer al sector de montañas del mundo (`Relieve.peso_montana`).
##    · PLAYA: la franja de arena junto a la orilla (y el agua somera pegada).
##      Se decide con `Relieve.altura(x, z) <= Relieve.COTA_ARENA`, EXACTAMENTE el
##      criterio con el que el mundo pinta la arena (`generador_ciudad.gd`:
##      `_distancia_a_arena`, `_generar_playa`, `_volcar_playa`). Nada inventado.
##
##  COMPORTAMIENTO:
##    · Dos reproductores (WAV de ciudad y WAV de playa), cada uno en LOOP infinito
##      recortado al tramo ÚTIL (sin el silencio de los extremos) para que no haya
##      pausa entre repeticiones.
##    · La zona se comprueba a baja frecuencia y sólo se cambia al CRUZAR de
##      verdad (con histéresis). Nunca se llama a play() por fotograma.
##    · Al cruzar, CROSSFADE con potencia constante (curvas seno/coseno): el nuevo
##      empieza ANTES de que el anterior baje y nunca hay un instante en silencio.
##      Ciudad<->Montaña es sólo una rampa de volumen del mismo WAV.
##    · Al terminar el fundido se detiene lo que quedó en silencio: nunca suenan
##      los dos a la vez ni quedan reproductores encendidos por cambios rápidos.
##    · Al arrancar se selecciona SÓLO la zona del jugador (nunca los dos).
##    · Reiniciar la partida recrea esta escena: no se acumulan reproductores.
##
##  No forma parte de ningún sistema previo: `SonidoUI` es sólo para la interfaz.

const RUTA_CIUDAD := "res://Audio/Ambiente/ciudad.wav"
const RUTA_PLAYA := "res://Audio/Ambiente/playa.wav"
## Bus de mezcla: los ambientes son una capa continua (como la música), así que
## van al bus "Musica" (existe en default_bus_layout.tres). No usa "Efectos"
## (reservado a los efectos puntuales, p. ej. la transformación).
const BUS := &"Musica"
## Nivel de silencio absoluto (el mínimo del bus en Godot).
const DB_SILENCIO := -80.0

## Tramo ÚTIL de cada WAV (segundos: inicio, fin), medido en ejecución. Los
## archivos traen silencio en los extremos: ciudad ≈0,475 s de cabeza y ≈0,605 s
## de cola; playa ≈0,134 s de cabeza y ≈0 de cola. Se recorta el LOOP a este tramo
## (con 0,05 s de margen hacia fuera para no cortar audio) para que no haya pausa
## de silencio entre repeticiones. El archivo original NO se toca.
const LOOP_CIUDAD := Vector2(0.455, 20.615)
const LOOP_PLAYA := Vector2(0.114, 45.130)

enum Zona { CIUDAD, MONTANA, PLAYA }

## Jugador cuya posición decide la zona. Por defecto el hermano "Jugador" de la
## escena del mundo (ziba_prototipo.tscn).
@export var ruta_jugador: NodePath = ^"../Jugador"
## Cada cuántos segundos se comprueba la zona (no hace falta cada fotograma).
@export_range(0.05, 1.0, 0.01) var intervalo_comprobacion := 0.2
## Duración del fundido cruzado entre ambientes (0 = cambio seco).
@export_range(0.0, 4.0, 0.05) var duracion_fundido := 1.0
## Volumen del ambiente de CIUDAD, en decibelios.
@export_range(-40.0, 6.0, 0.5) var vol_ciudad_db := -8.0
## Volumen del ambiente en la MONTAÑA (mismo WAV de ciudad, algo más fuerte).
@export_range(-40.0, 6.0, 0.5) var vol_montana_db := -4.0
## Volumen del ambiente de PLAYA, en decibelios.
@export_range(-40.0, 6.0, 0.5) var vol_playa_db := -8.0
## Altura (m) a partir de la cual el terreno fuera de la ciudad es MONTAÑA. La
## meseta urbana y la costa están a −0,18/−0,45 m; las colinas suben a partir de
## ~6 m, así que 3 m separa el llano de la ladera sin pisar ninguna meseta.
@export var altura_montana := 3.0
## Banda de histéresis (m) en las fronteras para no oscilar entre zonas. Debe ser
## MENOR que el desnivel meseta urbana (−0,18) ↔ línea de arena (−0,45) = 0,27 m,
## o al volver a la ciudad nunca se saldría de PLAYA.
@export var margen_histeresis := 0.15

var _rel := Relieve.new()
var _jugador: Node3D
var _p_ciudad: AudioStreamPlayer
var _p_playa: AudioStreamPlayer
var _zona: Zona = Zona.CIUDAD
var _acumulado := 0.0
var _fundido: Tween


func _ready() -> void:
	_p_ciudad = _crear_reproductor("AmbienteCiudad", RUTA_CIUDAD, LOOP_CIUDAD)
	_p_playa = _crear_reproductor("AmbientePlaya", RUTA_PLAYA, LOOP_PLAYA)
	_jugador = get_node_or_null(ruta_jugador) as Node3D
	# Arranque: SÓLO suena la zona del jugador (nunca los dos a la vez).
	_establecer_zona(_clasificar_en_jugador(_zona), true)


func _process(delta: float) -> void:
	if _jugador == null or not is_instance_valid(_jugador):
		_jugador = get_node_or_null(ruta_jugador) as Node3D
		if _jugador == null:
			return
	_acumulado += delta
	if _acumulado < intervalo_comprobacion:
		return
	_acumulado = 0.0
	var nueva := _clasificar_en_jugador(_zona)
	if nueva != _zona:
		_establecer_zona(nueva, false)


# --- Zona ---------------------------------------------------------------------

## Zona según la posición actual del jugador (manteniendo la actual para la
## histéresis). Si no hay jugador, se queda en ciudad (interior por defecto).
func _clasificar_en_jugador(actual: Zona) -> Zona:
	if _jugador == null:
		return actual
	var p := _jugador.global_position
	return _clasificar(p.x, p.z, actual)


## Clasifica el punto (x, z) en una zona. La frontera es la línea de arena del
## propio mundo (`COTA_ARENA`); la histéresis evita el parpadeo justo en el borde.
func _clasificar(x: float, z: float, actual: Zona) -> Zona:
	var h := _rel.altura(x, z)
	# 1) PLAYA: la franja de arena (misma cota con la que el mundo la pinta).
	var umbral_arena := Relieve.COTA_ARENA + (margen_histeresis if actual == Zona.PLAYA else -margen_histeresis)
	if h <= umbral_arena:
		return Zona.PLAYA
	# 2) CIUDAD: el recinto urbano (meseta cuadrada ±SEMI_MESETA) es SIEMPRE ciudad.
	if _rel.peso_ciudad(x, z) > 0.5:
		return Zona.CIUDAD
	# 3) MONTAÑA: fuera del recinto urbano, el terreno elevado o el sector de
	#    montañas del mundo. Usa el WAV de ciudad, más fuerte.
	var umbral_monte := altura_montana + (0.0 if actual == Zona.MONTANA else margen_histeresis)
	if h >= umbral_monte or _rel.peso_montana(x, z) > 0.5:
		return Zona.MONTANA
	return Zona.CIUDAD


## Frontera efectiva de arena, en metros de cota. Expuesta para pruebas.
func cota_arena() -> float:
	return Relieve.COTA_ARENA


# --- Reproducción -------------------------------------------------------------

func _crear_reproductor(nombre: String, ruta: String, tramo: Vector2) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.name = nombre
	p.bus = BUS
	p.volume_db = DB_SILENCIO
	var stream := _cargar_con_loop(ruta, tramo)
	if stream == null:
		push_warning("[AmbienteDinamico] No se encontró el ambiente: %s" % ruta)
	else:
		p.stream = stream
		if stream is AudioStreamWAV:
			var w: AudioStreamWAV = stream
			p.set_meta("inicio", float(w.loop_begin) / float(w.mix_rate))
	add_child(p)
	return p


## Carga el WAV y fija el LOOP infinito RECORTADO al tramo útil (sin el silencio
## de los extremos), sin depender de la importación ni de reimportar. No modifica
## el archivo .wav original.
func _cargar_con_loop(ruta: String, tramo: Vector2) -> AudioStream:
	if not ResourceLoader.exists(ruta):
		return null
	var s := load(ruta) as AudioStream
	if s is AudioStreamWAV:
		var w: AudioStreamWAV = s
		var sr := float(w.mix_rate)
		var total := int(round(w.get_length() * sr))
		w.loop_mode = AudioStreamWAV.LOOP_FORWARD
		w.loop_begin = clampi(int(floorf(tramo.x * sr)), 0, maxi(total - 2, 0))
		w.loop_end = clampi(int(ceilf(tramo.y * sr)), w.loop_begin + 1, total)
	return s


## Deja sonando SÓLO el ambiente de la zona indicada. instantaneo = sin fundido
## (arranque). En el fundido se interpolan las amplitudes de AMBOS reproductores
## hacia sus destinos: el que sube lo hace con curva seno y el que baja con coseno
## (potencia constante), así el nuevo empieza antes de que el anterior termine y
## nunca hay un instante en silencio.
func _establecer_zona(nueva: Zona, instantaneo: bool) -> void:
	_zona = nueva
	var activa := _p_playa if nueva == Zona.PLAYA else _p_ciudad
	if activa.stream != null and not activa.playing:
		activa.play(_inicio_de(activa))
	if _fundido != null and _fundido.is_valid():
		_fundido.kill()
	if instantaneo or duracion_fundido <= 0.0:
		_p_ciudad.volume_db = _objetivo_db(_p_ciudad)
		_p_playa.volume_db = _objetivo_db(_p_playa)
		_detener_inactivo()
		return
	var cur_c := db_to_linear(_p_ciudad.volume_db)
	var cur_p := db_to_linear(_p_playa.volume_db)
	var tgt_c := db_to_linear(_objetivo_db(_p_ciudad))
	var tgt_p := db_to_linear(_objetivo_db(_p_playa))
	_fundido = create_tween().set_parallel(true)
	_fundido.tween_method(_paso_fundido.bind(_p_ciudad, cur_c, tgt_c), 0.0, 1.0, duracion_fundido)
	_fundido.tween_method(_paso_fundido.bind(_p_playa, cur_p, tgt_p), 0.0, 1.0, duracion_fundido)
	_fundido.chain().tween_callback(_detener_inactivo)


## Un paso del fundido para UN reproductor: interpola su amplitud de [param cur] a
## [param tgt]. Si sube desde silencio usa seno y si baja a silencio usa coseno
## (curvas de potencia constante); si sólo cambia de nivel, interpola lineal.
func _paso_fundido(f: float, p: AudioStreamPlayer, cur: float, tgt: float) -> void:
	var eps := 0.0005
	var e := f
	if cur <= eps and tgt > eps:
		e = sin(f * PI * 0.5)          # entra desde silencio
	elif cur > eps and tgt <= eps:
		e = 1.0 - cos(f * PI * 0.5)    # sale hacia silencio
	var amp := lerpf(cur, tgt, e)
	p.volume_db = linear_to_db(maxf(amp, 0.0001))


## Volumen OBJETIVO (dB) de cada reproductor según la zona actual.
func _objetivo_db(p: AudioStreamPlayer) -> float:
	if p == _p_playa:
		return vol_playa_db if _zona == Zona.PLAYA else DB_SILENCIO
	match _zona:
		Zona.MONTANA:
			return vol_montana_db
		Zona.PLAYA:
			return DB_SILENCIO
		_:
			return vol_ciudad_db


## Detiene lo que quedó en silencio al acabar el fundido: nunca suenan los dos a
## la vez ni quedan reproductores encendidos por cambios rápidos.
func _detener_inactivo() -> void:
	if _p_ciudad != null and _objetivo_db(_p_ciudad) <= DB_SILENCIO and _p_ciudad.playing:
		_p_ciudad.stop()
	if _p_playa != null and _objetivo_db(_p_playa) <= DB_SILENCIO and _p_playa.playing:
		_p_playa.stop()


## Posición inicial (s) del loop de ese reproductor (para no oír el silencio de
## cabeza en la primera reproducción).
func _inicio_de(p: AudioStreamPlayer) -> float:
	return float(p.get_meta("inicio", 0.0))