extends SceneTree
## =============================================================================
##  RETARGETING de la LOCOMOCIÓN terrestre del personaje de VUELO
## =============================================================================
##  Adapta el clip `walk` del personaje de COMBATE (librería del módulo de ataque)
##  al esqueleto del maniquí Godot del personaje de VUELO, con la MISMA técnica ya
##  verificada del proyecto (la que usa el controlador para los clips de muerte):
##
##      local_destino(t) = A · local_origen(t) · B      (cambio de base por reposos)
##
##  Reutiliza `ControladorLeo._retarget_clip()` (con el mapa Mixamo→maniquí
##  MAPA_MIXAMO_MANIQUE) en vez de copiar el algoritmo: se instancia el jugador
##  real, se retargetea el clip sobre SU reproductor de vuelo y el clip resultante
##  se guarda como librería propia (res://…/vuelo/animations/vuelo_walk.tres).
##
##  Además MIDE las fases de CONTACTO de cada pie sobre el clip YA retargeteado
##  (mínimo real del tobillo/toe con el esqueleto aplicado) para el sistema de
##  pisadas, y valida la pista de posición de la cadera.
## =============================================================================

const JUGADOR := "res://personaje/base/escenas/leo_jugador.tscn"
const LIB_COMBATE := "res://personaje/transformaciones/transformacion ataque/animations/player_anim_library.tres"
const MODELO_COMBATE := "res://personaje/transformaciones/transformacion ataque/animations/pose t.fbx"
const SALIDA := "res://personaje/transformaciones/vuelo/animations/vuelo_walk.tres"
const NOMBRE := &"vuelo_walk"
const FPS_MEDICION := 240.0

func _init() -> void:
	var ps := load(JUGADOR) as PackedScene
	if ps == null:
		push_error("No carga " + JUGADOR)
		quit(1)
		return
	var jug := ps.instantiate()
	get_root().add_child(jug)
	var vuelo: Node = jug.get_node_or_null("Vuelo")
	var ap := vuelo.get_node_or_null("VisualRoot/AnimationLibrary_Godot_Standard/AnimationPlayer") as AnimationPlayer
	var skel := vuelo.get_node_or_null("VisualRoot/AnimationLibrary_Godot_Standard/Rig/GeneralSkeleton") as Skeleton3D
	var lib_combate := load(LIB_COMBATE) as AnimationLibrary
	if ap == null or skel == null or lib_combate == null:
		push_error("Faltan piezas: ap=%s skel=%s lib=%s" % [str(ap), str(skel), str(lib_combate)])
		quit(1)
		return

	var origen: Animation = lib_combate.get_animation("walk")
	if origen == null:
		push_error("El personaje de combate no tiene clip 'walk'")
		quit(1)
		return
	var mapa: Dictionary = (jug.get_script() as GDScript).get_script_constant_map().get("MAPA_MIXAMO_MANIQUE", {})
	print("[locomocion] retargeteando 'walk' (%.3f s, %d pistas) con %d huesos mapeados" % [
		origen.length, origen.get_track_count(), mapa.size()])
	var ok: bool = bool(jug.call("_retarget_clip", origen, ap, skel, NOMBRE, true, MODELO_COMBATE, mapa))
	print("[locomocion] retarget=", ok)
	if not ok:
		push_error("El retargeting no casó ningún hueso")
		quit(1)
		return
	var clip: Animation = ap.get_animation(NOMBRE)
	print("[locomocion] clip generado: %.3f s, %d pistas, loop=%d" % [clip.length, clip.get_track_count(), clip.loop_mode])

	# Validación de la pista de posición de la cadera (si vino del origen).
	for p in clip.get_track_count():
		if clip.track_get_type(p) == Animation.TYPE_POSITION_3D:
			var mn := INF
			var mx := -INF
			for k in clip.track_get_key_count(p):
				var v := clip.track_get_key_value(p, k) as Vector3
				mn = minf(mn, v.y)
				mx = maxf(mx, v.y)
			print("[locomocion] pista de posición '%s': y de %.4f a %.4f" % [
				String(clip.track_get_path(p)), mn, mx])

	# --- Medición de contactos de pie sobre el esqueleto REAL ---
	ap.current_animation = String(NOMBRE)
	var pies := {
		"izq": ["LeftFoot", "LeftToes"],
		"der": ["RightFoot", "RightToes"],
	}
	var n := int(clip.length * FPS_MEDICION)
	var muestras := {}
	for pie in pies:
		muestras[pie] = PackedFloat32Array()
	for k in n + 1:
		var t := clip.length * float(k) / float(n)
		ap.seek(t, true)
		var actualizado := false
		if skel.has_method("force_update_all_bone_transforms"):
			skel.call("force_update_all_bone_transforms")
			actualizado = true
		for pie in pies:
			var y := INF
			for nombre_hueso in (pies[pie] as Array):
				var i := skel.find_bone(StringName(nombre_hueso))
				if i >= 0:
					y = minf(y, (skel.global_transform * skel.get_bone_global_pose(i).origin).y)
			(muestras[pie] as PackedFloat32Array).append(y)
		if not actualizado and k == 0:
			print("[locomocion] aviso: sin force_update_all_bone_transforms (pose puede quedar sin actualizar)")
	var fases := {}
	for pie in pies:
		var arr: PackedFloat32Array = muestras[pie]
		var idx_min := 0
		var mejor := INF
		for k in arr.size():
			# Mínimo local "de verdad" (evita el pico del primer/último key).
			if k > 0 and k < arr.size() - 1 and arr[k] < arr[k - 1] and arr[k] <= arr[k + 1] and arr[k] < mejor:
				mejor = arr[k]
				idx_min = k
		fases[pie] = float(idx_min) / float(arr.size() - 1) if arr.size() > 1 else 0.0
		var mn := INF
		var mx := -INF
		for k in arr.size():
			mn = minf(mn, arr[k])
			mx = maxf(mx, arr[k])
		print("[locomocion] pie %s: fase de contacto %.4f (altura mín %.4f, máx %.4f, rango %.3f)" % [
			pie, fases[pie], mn, mx, mx - mn])

	# --- Guardar la librería SOLO con el clip nuevo ---
	var lib := AnimationLibrary.new()
	lib.add_animation(NOMBRE, clip)
	DirAccess.make_dir_recursive_absolute("res://personaje/transformaciones/vuelo/animations")
	var err := ResourceSaver.save(lib, SALIDA)
	print("[locomocion] guardado: %s (%s)" % [error_string(err), SALIDA])
	var recargada := load(SALIDA) as AnimationLibrary
	if recargada == null or not recargada.has_animation(NOMBRE):
		push_error("La librería guardada no se recarga")
		quit(1)
		return
	print("[locomocion] OK: %s con clips %s" % [SALIDA, str(recargada.get_animation_list())])
	print("[locomocion] FASES para PasosJugador → vuelo_walk: izq=%.4f der=%.4f" % [fases["izq"], fases["der"]])
	jug.free()
	quit()